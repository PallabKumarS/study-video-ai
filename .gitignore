# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/

# Production artifacts
/build
/dist

# Environment variables & secrets (NEVER commit secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Generated video outputs & media artifacts
/public/generated/*
!public/generated/.gitkeep
/scratch/
/_temp_inspect/
*.mp4
*.mkv
*.avi
*.wav
*.aac
*.png
*.jpg
*.jpeg

# Preserve assets
!assets/
!assets/fonts/**
!assets/**/*.ttf
!assets/**/*.otf

# Debug & task logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Electron build artifacts
/dist-electron

# OS files
.DS_Store
Thumbs.db
